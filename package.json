{
  "name": "@rulasfia/agents-telemetry",
  "version": "0.2.1",
  "description": "OpenTelemetry metrics and events extension for pi-coding-agent",
  "license": "MIT",
  "author": "mikeyobrien",
  "keywords": [
    "pi-package",
    "opentelemetry",
    "otlp",
    "metrics",
    "observability",
    "telemetry",
    "claude-code",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulasfia/agents-telemetry.git"
  },
  "bugs": "https://github.com/rulasfia/agents-telemetry/issues",
  "homepage": "https://github.com/rulasfia/agents-telemetry",
  "type": "module",
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/runner": "^4.0.18",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:claude": "tsc -p claude-plugin/tsconfig.json"
  }
}
