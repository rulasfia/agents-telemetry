{
  "name": "@rulasfia/agents-telemetry",
  "version": "0.2.1",
  "description": "OpenTelemetry metrics and events extension for pi-coding-agent",
  "license": "MIT",
  "author": "rulasfia",
  "keywords": [
    "pi-package",
    "opentelemetry",
    "otlp",
    "metrics",
    "observability",
    "telemetry",
    "claude-code",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulasfia/agents-telemetry.git"
  },
  "bugs": "https://github.com/rulasfia/agents-telemetry/issues",
  "homepage": "https://github.com/rulasfia/agents-telemetry",
  "type": "module",
  "pi": {
    "extensions": [
      "pi/src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/runner": "^4.0.18",
    "playwright": "^1.58.2",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:claude": "tsc -p claude/tsconfig.json",
    "dev:up": "mkdir -p stack/dev-out && DEV_UID=$(id -u) DEV_GID=$(id -g) docker compose -f stack/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f stack/docker-compose.dev.yml --profile dashboard down",
    "dev:logs": "docker compose -f stack/docker-compose.dev.yml logs -f otel-collector",
    "dev:metrics": "node scripts/dev-metrics.mjs",
    "dev:replay": "npm run build:claude && node scripts/dev-replay.mjs",
    "dev:pi": "PI_OTLP_ENABLE=1 OTEL_METRICS_EXPORTER=otlp OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4418} tsx scripts/dev-pi-session.ts",
    "dev:reset": "rm -f stack/dev-out/*.jsonl && docker compose -f stack/docker-compose.dev.yml restart otel-collector"
  }
}
