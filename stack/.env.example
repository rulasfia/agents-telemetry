# Pin versions; review and update these deliberately.
OTELCOL_VERSION=0.157.0
PROMETHEUS_VERSION=v3.13.2
GRAFANA_VERSION=13.1.1

# OTLP must be reachable from the Pi machine. Restrict port 4318 to your LAN/VPN
# with the homeserver firewall; do not expose it to the public internet.
OTLP_BIND_ADDRESS=0.0.0.0

# Keep Grafana local by default. Change only if protected by a reverse proxy or VPN.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password
PROMETHEUS_RETENTION=30d
